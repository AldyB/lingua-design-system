{
  "name": "@lingua/tokens",
  "version": "0.1.0",
  "description": "Lingua Design System — design tokens (Style Dictionary v4 pipeline)",
  "license": "MIT",
  "private": false,
  "type": "module",
  "main": "./dist/js/tokens.js",
  "module": "./dist/js/tokens.mjs",
  "types": "./dist/js/tokens.d.ts",
  "exports": {
    ".": {
      "types":   "./dist/js/tokens.d.ts",
      "import":  "./dist/js/tokens.mjs",
      "require": "./dist/js/tokens.js"
    },
    "./css/lingua.light.css":  "./dist/css/lingua.light.css",
    "./css/lingua.dark.css":   "./dist/css/lingua.dark.css",
    "./css/lingua.shadcn.css": "./dist/css/lingua.shadcn.css",
    "./tailwind":              "./dist/tailwind/lingua.tailwind.js",
    "./figma":                 "./dist/figma/lingua-figma-tokens.json"
  },
  "scripts": {
    "build":          "node build.mjs",
    "token-diff":     "node scripts/token-diff.mjs",
    "figma:push":     "node scripts/figma-push.mjs",
    "figma:update":   "node scripts/figma-push.mjs --update",
    "figma:dry-run":  "node scripts/figma-push.mjs --dry-run",
    "figma:payload":  "node scripts/figma-push.mjs --dry-run --save-payload",
    "clean":          "rm -rf dist"
  },
  "devDependencies": {
    "style-dictionary": "^4.3.3"
  }
}
